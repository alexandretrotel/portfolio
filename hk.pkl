amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["ultracite"] {
        check = "pnpm exec ultracite check {{files}}"
        fix = "pnpm exec ultracite fix {{files}}"
      }
    }
  }
}
