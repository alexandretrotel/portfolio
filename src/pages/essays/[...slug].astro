---
import { render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { getPartSlug, getPartTitle, getSortedEssays } from "../../lib/essays";

export const getStaticPaths = async () => {
    const essays = await getSortedEssays();
    return essays.flatMap((essay) =>
        essay.parts.map((entry, index) => ({
            params: { slug: getPartSlug(essay, index) },
            props: { essay, entry, index },
        })),
    );
};

const { essay, entry, index } = Astro.props;
const { Content } = await render(entry);
const total = essay.parts.length;
const hasPrev = index > 0;
const hasNext = index < total - 1;
---

<Article
    title={essay.title}
    description={essay.description}
    path={`/essays/${getPartSlug(essay, index)}`}
    date={essay.date}
    updated={essay.updated}
    {...(total > 1 && {
        chapter: getPartTitle(essay, index),
    })}
>
    <Content />

    {total > 1 && (
        <nav class="chapters" aria-label="Chapters">
            {hasPrev && (
                <a href={`/essays/${getPartSlug(essay, index - 1)}`} rel="prev">
                    ← {getPartTitle(essay, index - 1)}
                </a>
            )}
            {hasNext && (
                <a href={`/essays/${getPartSlug(essay, index + 1)}`} rel="next">
                    {getPartTitle(essay, index + 1)} →
                </a>
            )}
        </nav>
    )}
</Article>
