---
import Base from "../layouts/Base.astro";
import { FOOTER_LINKS, JSON_LD_CONTEXT, RESUME_LINK, SITE } from "../data/site";
import { getSortedArticles } from "../lib/articles";

const articles = await getSortedArticles();
const links = [...FOOTER_LINKS, RESUME_LINK];

const profilePageJsonLd = {
    "@context": JSON_LD_CONTEXT,
    "@type": "ProfilePage",
    url: SITE.url,
    mainEntity: {
        "@type": "Person",
        name: SITE.name,
        jobTitle: SITE.jobTitle,
        description: SITE.description,
        url: SITE.url,
        sameAs: SITE.sameAs,
        speakable: {
            "@type": "SpeakableSpecification",
            cssSelector: [".intro p"],
        },
    },
};

const websiteJsonLd = {
    "@context": JSON_LD_CONTEXT,
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    author: {
        "@type": "Person",
        name: SITE.name,
    },
};
---

<Base
    title={SITE.title}
    description={SITE.description}
    path="/"
    jsonLd={[profilePageJsonLd, websiteJsonLd]}
    home
>
    <header class="intro">
        <h1>{SITE.name}</h1>
        <p>I'm a founder and full-stack engineer.</p>
    </header>

    <h2 class="label">Work</h2>
    <p>
        I'm joining{" "}
        <a href="https://tengo.cc" target="_blank" rel="noopener noreferrer">
            Tengo
        </a>{" "}
        in Paris as a backend engineer.
    </p>
    <p>
        Before that, I co-founded{" "}
        <a
            href="https://x.com/radion_app"
            target="_blank"
            rel="noopener noreferrer"
        >
            Radion
        </a>
        , a real-time and historical data platform for prediction markets, and
        was its CTO. We ingested 8 billion Polymarket events in under two days
        and served them at 70ms p95 from a multi-threaded Rust API.
    </p>
    <p>
        Before Radion, I worked at{" "}
        <a
            href="https://www.allohouston.fr/"
            target="_blank"
            rel="noopener noreferrer"
        >
            <i>ALLO</i>
            <b>HOUSTON</b>
        </a>{" "}
        as a full-stack engineer, first as an intern and then as a freelancer.
        I wrote a conflict resolution algorithm that kept our database in sync
        with a client's CRM without losing local state. I also built an OCR
        pipeline that checked critical documents against public and private
        databases.
    </p>
    <p>
        During my studies, I co-founded Mindify, a startup that helps people
        discover new topics, and was its CTO. I built and shipped its web and
        mobile app, which passed 1,000 downloads.
    </p>
    <p>
        Around the same time, I interned at{" "}
        <a
            href="https://www.siborg.io/"
            target="_blank"
            rel="noopener noreferrer"
        >
            SiBorg
        </a>{" "}
        as a full-stack engineer and won{" "}
        <a
            href="https://devfolio.co/projects/siborg-ads-6138"
            target="_blank"
            rel="noopener noreferrer"
        >
            The Graph Prize
        </a>{" "}
        at the Coinbase Onchain Summer hackathon.
    </p>
    <p>
        My first startup was{" "}
        <a
            href="https://coinmarketcap.com/currencies/trotelcoin-v2/"
            target="_blank"
            rel="noopener noreferrer"
        >
            TrotelCoin
        </a>
        , a web3 app that taught students and non-technical people about
        blockchain. I wrote more than 10 Solidity smart contracts for it, and
        it reached over 200 users.
    </p>
    <p>
        Alongside it, I was vice president of{" "}
        <a
            href="https://www.n7consulting.fr/"
            target="_blank"
            rel="noopener noreferrer"
        >
            N7 Consulting
        </a>
        . I led a team of 26 and brought in €100K in revenue, working on
        strategy, operations, sales and management.
    </p>

    <h2 class="label">Projects</h2>
    <p>I also maintain developer tools, mostly in Rust:</p>
    <ul>
        <li>
            <a
                href="https://github.com/alexandretrotel/todo-tree"
                target="_blank"
                rel="noopener noreferrer"
            >
                todo-tree
            </a>{" "}
            finds every TODO comment in a codebase.
        </li>
    </ul>

    <h2 class="label">Hobbies</h2>
    <p>
        I read non-fiction, manga and manhwa, and I watch anime. I run 20 to
        30 km a week and play badminton.
    </p>
    <p>I play the piano and make EDM in FL Studio.</p>
    <p>
        Every day I share what I learn on Instagram, where I have over 10k
        followers.
    </p>

    <h2 class="label">Writing</h2>
    <ul class="posts">
        {articles.map((article) => (
            <li>
                <a href={`/articles/${article.slug}`}>{article.title}</a>
            </li>
        ))}
    </ul>

    <footer slot="footer">
        <nav aria-label="Links">
            <ul>
                {links.map((link) => (
                    <li>
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {link.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </footer>
</Base>
