---
import Base from "../layouts/Base.astro";
import { JSON_LD_CONTEXT, SITE, FOOTER_LINKS, RESUME_LINK } from "../data/site";
import { getSortedEssays } from "../lib/essays";

const essays = await getSortedEssays();

const profilePageJsonLd = {
    "@context": JSON_LD_CONTEXT,
    "@type": "ProfilePage",
    url: SITE.url,
    mainEntity: {
        "@type": "Person",
        name: SITE.name,
        jobTitle: SITE.jobTitle,
        description: SITE.description,
        url: SITE.url,
        sameAs: SITE.sameAs,
        speakable: {
            "@type": "SpeakableSpecification",
            cssSelector: ["main > p:first-of-type"],
        },
    },
};

const websiteJsonLd = {
    "@context": JSON_LD_CONTEXT,
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    author: {
        "@type": "Person",
        name: SITE.name,
    },
};
---

<Base
    title={SITE.title}
    description={SITE.description}
    path="/"
    jsonLd={[profilePageJsonLd, websiteJsonLd]}
>
    <h1>{SITE.name}</h1>
    <p>I'm a founder and full-stack engineer.</p>

    <h2>Work</h2>
    <p>
        I'm joining{" "}
        <a href="https://tengo.cc" target="_blank" rel="noopener noreferrer">
            Tengo
        </a>{" "}
        in Paris as a backend engineer.
    </p>
    <p>
        Before that, I co-founded{" "}
        <a
            href="https://x.com/radion_app"
            target="_blank"
            rel="noopener noreferrer"
        >
            Radion
        </a>{" "}
        as CTO, a real-time and historical data platform for prediction markets.
        We ingested 8 billion Polymarket events in under two days and served
        them at 70ms p95 from a multi-threaded Rust API.
    </p>
    <p>
        Before Radion, I was a full-stack engineer, intern then freelancer, at{" "}
        <a
            href="https://www.allohouston.fr/"
            target="_blank"
            rel="noopener noreferrer"
        >
            <i>ALLO</i>
            <b>HOUSTON</b>
        </a>
        . I wrote a conflict resolution algorithm that kept our database in sync
        with a client's CRM without losing local state, and built an OCR
        pipeline that checked critical documents against public and private
        databases.
    </p>
    <p>
        During my studies, I co-founded Mindify as CTO, a startup helping people
        discover new topics and change their daily life. I built and shipped its
        web and mobile app, with 1,000+ downloads.
    </p>
    <p>
        Around the same time, I interned at{" "}
        <a
            href="https://www.siborg.io/"
            target="_blank"
            rel="noopener noreferrer"
        >
            SiBorg
        </a>{" "}
        as a full-stack engineer and won{" "}
        <a
            href="https://devfolio.co/projects/siborg-ads-6138"
            target="_blank"
            rel="noopener noreferrer"
        >
            The Graph Prize
        </a>{" "}
        at the Coinbase Onchain Summer hackathon.
    </p>
    <p>
        It all started with my first startup,{" "}
        <a
            href="https://coinmarketcap.com/currencies/trotelcoin-v2/"
            target="_blank"
            rel="noopener noreferrer"
        >
            TrotelCoin
        </a>
        , a web3 app teaching students and non-technical users about blockchain.
        I wrote 10+ Solidity smart contracts and reached 200+ users.
    </p>
    <p>
        In parallel, I was vice president of{" "}
        <a
            href="https://www.n7consulting.fr/"
            target="_blank"
            rel="noopener noreferrer"
        >
            N7 Consulting
        </a>
        . I led a team of 26 and generated €100K in revenue, working on
        strategy, operations, sales and management.
    </p>

    <h2>Projects</h2>
    <p>I also maintain developer tools, mostly in Rust:</p>
    <ul>
        <li>
            <a
                href="https://github.com/alexandretrotel/todo-tree"
                target="_blank"
                rel="noopener noreferrer"
            >
                todo-tree
            </a>{" "}
            finds every TODO comment in a codebase.
        </li>
        <li>
            <a
                href="https://github.com/alexandretrotel/dotfiles-manager"
                target="_blank"
                rel="noopener noreferrer"
            >
                dotfiles-manager
            </a>{" "}
            syncs dotfiles across machines with profiles.
        </li>
    </ul>

    <h2>Hobbies</h2>
    <p>
        I read non-fiction, manga and manhwa, and watch anime. I run 20-30 km
        per week and play badminton.
    </p>
    <p>I play the piano and make EDM on FL Studio.</p>
    <p>I share what I learn daily on Instagram, where I have 10k+ followers.</p>

    <h2>Writing</h2>
    <ul>
        {essays.map((essay) => (
            <li>
                <a href={`/essays/${essay.slug}`}>{essay.title}</a>
            </li>
        ))}
    </ul>

    <footer slot="footer">
        <ul>
            {FOOTER_LINKS.map((link) => (
                <li>
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {link.name}
                    </a>
                </li>
            ))}
            <li>
                <a
                    href={RESUME_LINK.url}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {RESUME_LINK.name}
                </a>
            </li>
        </ul>
    </footer>
</Base>
