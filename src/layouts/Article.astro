---
import Base from "./Base.astro";
import { JSON_LD_CONTEXT, SITE } from "../data/site";

interface Props {
    title: string;
    description: string;
    path: string;
    date: Date;
}

const { title, description, path, date } = Astro.props;
const url = new URL(path, SITE.url).toString();

const articleJsonLd = {
    "@context": JSON_LD_CONTEXT,
    "@type": "Article",
    headline: title,
    description,
    url,
    datePublished: date.toISOString().slice(0, 10),
    author: {
        "@type": "Person",
        name: SITE.name,
        url: SITE.url,
    },
    mainEntityOfPage: url,
};
---

<Base
    title={title}
    description={description}
    path={path}
    type="article"
    jsonLd={[articleJsonLd]}
>
    <article>
        <header class="intro">
            <h1>{title}</h1>
        </header>

        <slot />
    </article>
</Base>

<style is:global>
    article {
      overflow-wrap: break-word;
    }

    article > :is(p, ul, ol, blockquote) {
      line-height: 1.375rem;
    }

    article > .intro {
      margin-bottom: 1.5rem;
    }

    .intro a {
      color: inherit;
    }

    @media (max-width: 48rem) {
      article > .intro {
        padding-right: 3rem;
      }
    }

    article h2 {
      margin-top: 2.25rem;
      font-weight: 560;
    }

    article h3 {
      margin-top: 1.5rem;
    }

    article :is(h2, h3) {
      scroll-margin-top: 4rem;
    }

    @media (min-width: 48rem) {
      article :is(h2, h3) {
        scroll-margin-top: 6rem;
      }
    }

    /* Focusable only so fragment navigation moves focus; not interactive, so no ring */
    article :is(h2, h3)[tabindex="-1"]:focus {
      outline: none;
    }

    article :is(h2, h3) > a {
      text-decoration-color: transparent;
    }

    @media (hover: hover) {
      article :is(h2, h3) > a:hover {
        text-decoration-color: var(--underline);
      }
    }

    article > ul:not(.contains-task-list) {
      padding-left: 1.25rem;
      list-style: disc;
    }

    article > ol {
      padding-left: 1.25rem;
      list-style: decimal;
    }

    article li + li {
      margin-top: 0.375rem;
    }

    article ::marker {
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    article > p + :is(ul, ol) {
      margin-top: 0.5rem;
    }

    .toc,
    .toc-mobile {
      color: var(--muted-foreground);
      scroll-target-group: auto;
    }

    :is(.toc, .toc-mobile) a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    :is(.toc, .toc-mobile) a:is([aria-current], .target-current) {
      color: var(--foreground);
    }

    @media (hover: hover) {
      :is(.toc, .toc-mobile) a:hover {
        color: var(--foreground);
      }
    }

    :is(.toc, .toc-mobile) li ol {
      margin-block: 0.25rem 0.5rem;
      padding-left: 0.75rem;
    }

    article > .intro:has(+ .toc-mobile) {
      margin-bottom: 1rem;
    }

    .toc-mobile {
      margin-bottom: 2rem;
    }

    .toc-mobile summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 2.75rem;
      list-style: none;
      cursor: pointer;
      user-select: none;
    }

    .toc-mobile summary::-webkit-details-marker {
      display: none;
    }

    .toc-mobile summary span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .toc-mobile summary::after {
      flex-shrink: 0;
      width: 0.375rem;
      height: 0.375rem;
      margin: -0.25rem 0.25rem 0;
      border-right: 1px solid currentcolor;
      border-bottom: 1px solid currentcolor;
      content: "";
      rotate: 45deg;
    }

    .toc-mobile details[open] summary::after {
      margin-top: 0.25rem;
      rotate: 225deg;
    }

    .toc-mobile details::details-content {
      interpolate-size: allow-keywords;
      overflow: clip;
      contain: layout;
    }

    .toc-mobile details:not([open])::details-content {
      block-size: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .toc-mobile summary::after {
        transition:
          rotate 0.2s var(--ease-out),
          margin 0.2s var(--ease-out);
      }

      .toc-mobile details::details-content {
        transition:
          block-size 0.3s var(--ease-out),
          content-visibility 0.3s var(--ease-out) allow-discrete;
      }
    }

    .toc-mobile details > ol {
      padding-bottom: 0.5rem;
    }

    .toc-mobile a {
      padding-block: 0.4375rem;
    }

    @media (hover: hover) {
      .toc-mobile summary:hover {
        color: var(--foreground);
      }
    }

    .toc {
      display: none;
    }

    @media (min-width: 75rem) {
      article {
        position: relative;
      }

      .toc {
        display: block;
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(100% + 3rem);
        width: 14rem;
        margin-top: 0;
        font-size: var(--text-xs);
      }

      .toc > ol {
        position: sticky;
        top: 6rem;
      }

      .toc li + li {
        margin-top: 0.375rem;
      }

      .toc-mobile {
        display: none;
      }
    }

    .chapters {
      display: flex;
      gap: 1rem;
      margin-top: 3rem;
    }

    .chapters a {
      padding-block: 0.5rem;
      text-decoration: none;
      transition: opacity 0.15s ease;
    }

    .chapters a[rel="next"] {
      margin-left: auto;
      text-align: right;
    }

    @media (hover: hover) {
      .chapters a:hover {
        opacity: 0.6;
      }
    }

    article .contains-task-list {
      padding-left: 0;
    }

    article .task-list-item + .task-list-item {
      margin-top: 0.25rem;
    }

    article .task-list-item label {
      display: flex;
      gap: 0.75rem;
      padding-block: 0.625rem;
      cursor: pointer;
    }

    article .task-list-item input {
      flex-shrink: 0;
      width: 1rem;
      height: 1rem;
      margin: 0.1875rem 0 0;
      cursor: pointer;
    }

    article .task-list-item:has(input:checked) label {
      color: var(--muted-foreground);
      text-decoration: line-through;
      text-decoration-color: var(--underline);
    }

    blockquote {
      position: relative;
      margin: 1.5rem 0 0;
      padding-left: 1rem;
      font-weight: 500;
    }

    blockquote::before {
      position: absolute;
      inset: 0 auto 0 0;
      width: 2px;
      border-radius: 2px;
      background: var(--border-strong);
      content: "";
    }

    blockquote + * {
      margin-top: 1.5rem;
    }

    code {
      padding: 0.1rem 0.3rem;
      border-radius: 0.3125rem;
      background: var(--muted);
      color: var(--soft-foreground);
      font-family: var(--font-mono);
      font-size: 0.9em;
      letter-spacing: 0;
    }

    pre {
      overflow-x: auto;
      padding: 0.875rem 1rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: var(--muted);
      font-size: var(--text-xs);
      line-height: 1.55;
      scrollbar-width: none;
    }

    article > pre {
      margin-block: 1.25rem;
    }

    pre code {
      padding: 0;
      border-radius: 0;
      background: none;
      color: inherit;
      font-size: inherit;
    }

    .astro-code,
    .astro-code span {
      color: light-dark(var(--shiki-light), var(--shiki-dark));
    }

    @media (max-width: 32.5rem) {
      article > pre {
        margin-inline: calc(var(--gutter) * -1);
        padding-inline: var(--gutter);
        border-inline: 0;
        border-radius: 0;
      }
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-xs);
    }

    th,
    td {
      padding: 0.375rem 0.75rem;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }

    :is(th, td):first-child {
      padding-left: 0;
    }

    :is(th, td):last-child {
      padding-right: 0;
    }

    th {
      font-weight: 500;
    }

    td {
      color: var(--soft-foreground);
    }

    hr {
      border: 0;
      border-top: 1px solid var(--border);
    }

    .visually-hidden:where(:not(:focus-within, :active)) {
      position: absolute !important;
      clip-path: inset(50%) !important;
      overflow: hidden !important;
      width: 1px !important;
      height: 1px !important;
      margin: -1px !important;
      padding: 0 !important;
      border: 0 !important;
      white-space: nowrap !important;
    }

</style>

<script>
    if (document.querySelector("article pre > code.language-mermaid")) {
        void import("../scripts/mermaid").then(({ renderMermaid }) => renderMermaid());
    }

    if (document.querySelector("[data-clock-sweep]")) {
        void import("../scripts/clock-sweep").then(({ mountClockSweeps }) => mountClockSweeps());
    }

    {
        interface Mount { default: (root: HTMLElement) => void }
        const demos: Record<string, () => Promise<Mount>> = {
            "wire-message": () => import("../scripts/wire-message"),
            "wire-extended": () => import("../scripts/wire-extended"),
            "pg-connections": () => import("../scripts/pg-connections"),
            "executor-pull": () => import("../scripts/executor-pull"),
            "pg-page": () => import("../scripts/pg-page"),
            "pg-row": () => import("../scripts/pg-row"),
            "react-stream": () => import("../scripts/react-stream"),
            "react-hydration": () => import("../scripts/react-hydration"),
            "react-work-loop": () => import("../scripts/react-work-loop"),
            "react-lanes": () => import("../scripts/react-lanes"),
            "react-hooks": () => import("../scripts/react-hooks"),
            "react-hook-slots": () => import("../scripts/react-hooks"),
            "switch-bar": () => import("../scripts/switch-bar"),
            "market-size": () => import("../scripts/market-size"),
        };

        for (const [name, load] of Object.entries(demos)) {
            const roots = document.querySelectorAll<HTMLElement>(`[data-demo="${name}"]`);
            if (roots.length > 0) {
                void (async () => {
                    const { default: mount } = await load();
                    for (const root of roots) {mount(root);}
                })();
            }
        }
    }
</script>

<script>
    {
        const key = `checklist:${location.pathname}`;
        const boxes = [
            ...document.querySelectorAll<HTMLInputElement>(
                "article .task-list-item > input[type='checkbox']",
            ),
        ];

        const items = boxes.flatMap((box) => {
            const item = box.parentElement;
            if (!item) {return [];}

            const label = document.createElement("label");
            label.append(...item.childNodes);
            item.append(label);
            return [{ box, text: label.textContent?.trim() ?? "" }];
        });

        const readChecked = (): Set<string> => {
            try {
                const saved: unknown = JSON.parse(localStorage.getItem(key) ?? "[]");
                if (!Array.isArray(saved)) {return new Set();}
                if (saved.every((value) => typeof value === "boolean")) {
                    return new Set(items.filter((_, index) => saved[index] === true).map(({ text }) => text));
                }
                return new Set(saved.filter((value): value is string => typeof value === "string"));
            } catch {
                return new Set();
            }
        };
        const checked = readChecked();

        const save = () => {
            try {
                localStorage.setItem(
                    key,
                    JSON.stringify(items.filter(({ box }) => box.checked).map(({ text }) => text)),
                );
            } catch {
                // localStorage unavailable (private mode, blocked storage)
            }
        };

        for (const { box, text } of items) {
            box.disabled = false;
            box.checked = checked.has(text);
            box.addEventListener("change", save);
        }
    }
</script>
