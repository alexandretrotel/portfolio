---
import Base from "./Base.astro";
import { JSON_LD_CONTEXT, SITE } from "../data/site";

interface Props {
    title: string;
    description: string;
    path: string;
    date: Date;
}

const { title, description, path, date } = Astro.props;
const url = new URL(path, SITE.url).toString();

const articleJsonLd = {
    "@context": JSON_LD_CONTEXT,
    "@type": "Article",
    headline: title,
    description,
    url,
    datePublished: date.toISOString().slice(0, 10),
    author: {
        "@type": "Person",
        name: SITE.name,
        url: SITE.url,
    },
    mainEntityOfPage: url,
};
---

<Base
    title={title}
    description={description}
    path={path}
    type="article"
    jsonLd={[articleJsonLd]}
>
    <article>
        <header>
            <h1>{title}</h1>
        </header>

        <slot />
    </article>
</Base>

<style is:global>
    article > header {
      margin-bottom: 2rem;
    }

    article h2 {
      margin-top: 2.5rem;
    }

    .chapters {
      display: flex;
      gap: 1rem;
      margin-top: 3rem;
    }

    .chapters a {
      padding-block: 0.5rem;
    }

    .chapters a[rel="next"] {
      margin-left: auto;
      text-align: right;
    }

    article h3 {
      margin-top: 2rem;
    }

    .toc,
    .toc-mobile {
      color: var(--muted-foreground);
      font-size: 0.875rem;
    }

    :is(.toc, .toc-mobile) ol {
      padding-left: 0;
      list-style: none;
    }

    :is(.toc, .toc-mobile) li {
      margin-top: 0.5rem;
    }

    :is(.toc, .toc-mobile) li[aria-current="page"] > a {
      color: var(--foreground);
    }

    :is(.toc, .toc-mobile) li ol {
      padding-left: 0.75rem;
    }

    :is(.toc, .toc-mobile) a {
      color: inherit;
      text-decoration: none;
    }

    :is(.toc, .toc-mobile) a:hover,
    :is(.toc, .toc-mobile) a[aria-current="location"] {
      color: var(--foreground);
    }

    article > header:has(+ .toc-mobile) {
      margin-bottom: 1rem;
    }

    .toc-mobile {
      margin-bottom: 3rem;
    }

    .toc-mobile summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-block: 0.625rem;
      list-style: none;
      cursor: pointer;
    }

    .toc-mobile summary::-webkit-details-marker {
      display: none;
    }

    .toc-mobile summary span {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .toc-mobile summary::after {
      width: 0.375rem;
      height: 0.375rem;
      margin-right: 0.25rem;
      border-right: 1px solid currentcolor;
      border-bottom: 1px solid currentcolor;
      content: "";
      transform: translateY(-25%) rotate(45deg);
    }

    .toc-mobile details[open] summary::after {
      transform: translateY(25%) rotate(-135deg);
    }

    .toc-mobile li {
      margin-top: 0;
    }

    .toc-mobile a {
      display: block;
      padding-block: 0.3125rem;
    }

    .toc-mobile summary:hover {
      color: var(--foreground);
    }

    .toc {
      display: none;
    }

    @media (min-width: 75rem) {
      article {
        position: relative;
      }

      .toc {
        display: block;
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(100% + 3rem);
        width: 14rem;
        margin-top: 0;
      }

      .toc > ol {
        position: sticky;
        top: 2rem;
      }

      .toc > ol > li:first-child {
        margin-top: 0;
      }

      .toc-mobile {
        display: none;
      }
    }

    article :is(h2, h3) {
      scroll-margin-top: 1.5rem;
    }

    article :is(h2, h3) > a {
      color: inherit;
      text-decoration: none;
    }

    article :is(h2, h3) > a:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
    }

    article .contains-task-list {
      padding-left: 0;
      list-style: none;
    }

    article .task-list-item + .task-list-item {
      margin-top: 0.625rem;
    }

    article .task-list-item label {
      display: flex;
      gap: 0.625rem;
      cursor: pointer;
    }

    article .task-list-item input {
      flex-shrink: 0;
      width: 1rem;
      height: 1rem;
      margin: 0.2rem 0 0;
      accent-color: var(--link);
      cursor: pointer;
    }

    article .task-list-item:has(input:checked) label {
      color: var(--muted-foreground);
      text-decoration: line-through;
    }

    blockquote {
      margin: 1.25rem 0 0;
      padding-left: 1rem;
      border-left: 1px solid var(--border);
      color: var(--muted-foreground);
    }

    code {
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
      background: var(--muted);
      font-family: ui-monospace, monospace;
      font-size: 0.875rem;
    }

    pre {
      overflow-x: auto;
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 0.625rem;
      background: var(--muted);
      font-size: 0.875rem;
      line-height: 1.625;
    }

    pre code {
      padding: 0;
      border-radius: 0;
      background: none;
      font-size: inherit;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    th,
    td {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--border);
      text-align: left;
    }

    th {
      font-weight: 500;
    }

    hr {
      border: 0;
      border-top: 1px solid var(--border);
    }
</style>

<script>
    {
        const key = `checklist:${location.pathname}`;
        const boxes = [
            ...document.querySelectorAll<HTMLInputElement>(
                "article .task-list-item > input[type='checkbox']",
            ),
        ];

        const readChecked = () => {
            try {
                const saved = JSON.parse(localStorage.getItem(key) ?? "[]");
                return Array.isArray(saved) ? saved : [];
            } catch {
                return [];
            }
        };
        const checked = readChecked();

        const save = () => {
            try {
                localStorage.setItem(key, JSON.stringify(boxes.map((box) => box.checked)));
            } catch {
                // localStorage unavailable (private mode, blocked storage)
            }
        };

        for (const [index, box] of boxes.entries()) {
            const item = box.parentElement;
            if (!item) {continue;}

            const label = document.createElement("label");
            label.append(...item.childNodes);
            item.append(label);

            box.disabled = false;
            box.checked = checked[index] === true;
            box.addEventListener("change", save);
        }
    }
</script>
