---
import type { MarkdownHeading } from "astro";
import type { Article } from "../lib/articles";
import { getPartSlug, getPartTitle } from "../lib/articles";

interface Props {
    article: Article;
    index: number;
    sections: MarkdownHeading[];
}

const { article, index, sections } = Astro.props;
---

<ol>
    {article.parts.map((_, i) => (
        <li>
            <a
                href={`/articles/${getPartSlug(article, i)}`}
                aria-current={i === index ? "page" : undefined}
            >
                {getPartTitle(article, i)}
            </a>
            {i === index && sections.length > 0 && (
                <ol>
                    {sections.map((section) => (
                        <li>
                            <a href={`#${section.slug}`}>{section.text}</a>
                        </li>
                    ))}
                </ol>
            )}
        </li>
    ))}
</ol>
