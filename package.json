{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "pnpm run build && npx wrangler dev",
    "deploy": "pnpm run build && npx wrangler deploy",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run lint:html && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "check": "pnpm run format:check && pnpm run lint"
  },
  "devDependencies": {
    "html-validate": "^11.6.1",
    "oxfmt": "^0.61.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
