{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "www.alexandretrotel.org",
      "custom_domain": true
    }
  ]
}
